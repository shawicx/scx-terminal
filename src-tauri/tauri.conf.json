{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "scx-terminal",
  "version": "0.2.0",
  "identifier": "com.scx.terminal",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "scx-terminal",
        "width": 1100,
        "height": 700,
        "minWidth": 500,
        "minHeight": 300,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": false,
        "acceptFirstMouse": true,
        "trafficLightPosition": {
          "x": 20,
          "y": 17
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "both",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "headerImage": "./icons/nsis-header.bmp",
        "sidebarImage": "./icons/nsis-sidebar.bmp"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcyNDkzQzQ2NTUzRkQ1MjYKUldRbTFUOVZSanhKY3VFNWx2ZUxGMTZiMk1qd2tOZ1h5eHBhSWFIWE9qcHJuUnR2UmluK3dhc3MK",
      "endpoints": [
        "https://github.com/shawicx/scx-terminal/releases/latest/download/latest.json"
      ]
    }
  }
}
